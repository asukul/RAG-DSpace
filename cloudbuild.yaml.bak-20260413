# Two-stage Cloud Build for the Vertex + Qdrant RAG stack:
#   1. Build + push + deploy backend, capture its run.app URL
#   2. Build frontend with VITE_API_URL=<backend URL>, push, deploy
#
# Required setup (one-time, see DEPLOY.md):
#   - Cloud Run runtime SA (PROJECT_NUMBER-compute@developer.gserviceaccount.com)
#     has roles/aiplatform.user on the project (so Vertex Gemini + embeddings work)
#   - Cloud Build SA needs: run.admin, iam.serviceAccountUser
#   - Qdrant VM (qdrant-vm in us-central1-a) is reachable on its external IP
#     (set via QDRANT_URL env var below)
#   - No Gemini API key in Secret Manager — Vertex auths via the runtime SA
#
# Trigger manually:
#   gcloud builds submit --config=cloudbuild.yaml --project=rag-dspace .

steps:
  # ----------------------------------------------------------
  # 1. Build + push backend image
  # ----------------------------------------------------------
  - id: backend-build
    name: 'gcr.io/cloud-builders/docker'
    args:
      - 'build'
      - '-t'
      - 'gcr.io/$PROJECT_ID/backend:$BUILD_ID'
      - '-t'
      - 'gcr.io/$PROJECT_ID/backend:latest'
      - './backend'

  - id: backend-push
    name: 'gcr.io/cloud-builders/docker'
    waitFor: ['backend-build']
    args: ['push', '--all-tags', 'gcr.io/$PROJECT_ID/backend']

  # ----------------------------------------------------------
  # 2. Deploy backend to Cloud Run, write its URL to /workspace/backend_url
  # ----------------------------------------------------------
  - id: backend-deploy
    name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    waitFor: ['backend-push']
    entrypoint: bash
    args:
      - '-c'
      - |
        set -e
        gcloud run deploy backend \
          --image=gcr.io/$PROJECT_ID/backend:$BUILD_ID \
          --region=${_REGION} \
          --platform=managed \
          --allow-unauthenticated \
          --memory=2Gi \
          --cpu=1 \
          --timeout=300 \
          --min-instances=0 \
          --max-instances=3 \
          --set-env-vars="^|^EMBEDDING_BACKEND=vertex|GCP_PROJECT=$PROJECT_ID|GCP_LOCATION=${_REGION}|QDRANT_URL=${_QDRANT_URL}|QDRANT_COLLECTION=dspace_chunks|GEMINI_GEN_MODEL=gemini-2.5-flash-lite|VERTEX_EMBEDDING_MODEL=text-embedding-005|DSPACE_BASE_URL=https://dr.lib.iastate.edu|GOOGLE_OAUTH_CLIENT_ID=${_GOOGLE_OAUTH_CLIENT_ID}|JWT_SECRET=${_JWT_SECRET}|DEFAULT_ADMIN_EMAIL=${_DEFAULT_ADMIN_EMAIL}|USERS_DB_PATH=/tmp/users.db"
        gcloud run services describe backend \
          --region=${_REGION} \
          --format='value(status.url)' > /workspace/backend_url
        echo "Backend URL: $(cat /workspace/backend_url)"

  # ----------------------------------------------------------
  # 3. Build frontend image with the captured backend URL baked in
  # ----------------------------------------------------------
  - id: frontend-build
    name: 'gcr.io/cloud-builders/docker'
    waitFor: ['backend-deploy']
    entrypoint: bash
    args:
      - '-c'
      - |
        set -e
        BACKEND_URL=$(cat /workspace/backend_url)
        docker build \
          --build-arg VITE_API_URL=$$BACKEND_URL \
          --build-arg VITE_GOOGLE_OAUTH_CLIENT_ID=${_GOOGLE_OAUTH_CLIENT_ID} \
          -t gcr.io/$PROJECT_ID/frontend:$BUILD_ID \
          -t gcr.io/$PROJECT_ID/frontend:latest \
          ./frontend

  - id: frontend-push
    name: 'gcr.io/cloud-builders/docker'
    waitFor: ['frontend-build']
    args: ['push', '--all-tags', 'gcr.io/$PROJECT_ID/frontend']

  # ----------------------------------------------------------
  # 4. Deploy frontend to Cloud Run
  # ----------------------------------------------------------
  - id: frontend-deploy
    name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    waitFor: ['frontend-push']
    entrypoint: gcloud
    args:
      - 'run'
      - 'deploy'
      - 'frontend'
      - '--image=gcr.io/$PROJECT_ID/frontend:$BUILD_ID'
      - '--region=${_REGION}'
      - '--platform=managed'
      - '--allow-unauthenticated'
      - '--memory=512Mi'
      - '--cpu=1'
      - '--min-instances=0'
      - '--max-instances=3'

substitutions:
  _REGION: us-central1
  _QDRANT_URL: 'http://35.188.64.146:6333'  # qdrant-vm external IP in rag-dspace
  _GOOGLE_OAUTH_CLIENT_ID: ''  # set via --substitutions when invoking
  _JWT_SECRET: 'dev-secret-please-override-with-long-random-string-32+chars'
  _DEFAULT_ADMIN_EMAIL: 'adisak.sukul@gmail.com'

options:
  logging: CLOUD_LOGGING_ONLY
  machineType: E2_HIGHCPU_8

images:
  - 'gcr.io/$PROJECT_ID/backend:$BUILD_ID'
  - 'gcr.io/$PROJECT_ID/backend:latest'
  - 'gcr.io/$PROJECT_ID/frontend:$BUILD_ID'
  - 'gcr.io/$PROJECT_ID/frontend:latest'
